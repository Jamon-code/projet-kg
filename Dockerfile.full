FROM jupyter/scipy-notebook:latest

# Java (pour Spark) — installe en root
USER root
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jre-headless \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
USER ${NB_UID}

# Librairies : LLM (DeepSeek), Neo4j, Spark local, Streamlit
RUN pip install --no-cache-dir \
    "numpy<2" \
    openai \
    neo4j \
    python-dotenv \
    networkx \
    pyvis \
    streamlit \
    "pyspark==3.5.0" \
    fastapi \
    "uvicorn[standard]"
